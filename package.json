{
  "name": "nyc-map-agent",
  "private": true,
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --exclude 'e2e/**' --exclude '**/node_modules/**'",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts status",
    "db:refresh": "tsx scripts/refresh-marts.ts",
    "transit:observe": "tsx scripts/transit-observe.ts",
    "ingest": "tsx scripts/ingest.ts && tsx scripts/refresh-marts.ts",
    "build:city-tiles": "tsx scripts/build-city-tiles.ts",
    "load:areas": "tsx scripts/load-areas.ts",
    "build:aggregates": "tsx scripts/build-aggregates.ts",
    "start": "tsx server/node.ts",
    "build:sign-tiles": "tsx scripts/build-sign-tiles.ts",
    "build:skyline-tiles": "tsx scripts/build-skyline-tiles.ts",
    "publish:city-tiles": "tsx scripts/publish-city-tiles.ts",
    "build:block-tiles": "tsx scripts/build-block-tiles.ts",
    "publish:block-tiles": "tsx scripts/publish-city-tiles.ts public/tiles/nyc-blocks.pmtiles && tsx scripts/publish-city-tiles.ts public/tiles/nyc-blocks.geojson",
    "lint:boundaries": "depcruise src server api scripts --config .dependency-cruiser.cjs",
    "build:size": "vite build --outDir .size-build --emptyOutDir",
    "size": "size-limit",
    "feeds:health": "tsx scripts/feed-health.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "lint:commit": "commitlint --verbose",
    "check:layout-tests": "tsx scripts/check-layout-tests.ts",
    "lint": "eslint . --max-warnings=0 --suppressions-location eslint-suppressions.json --pass-on-unpruned-suppressions",
    "lint:prune": "eslint . --suppressions-location eslint-suppressions.json --prune-suppressions",
    "knip": "knip --no-progress",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "build:transit": "tsx scripts/build-transit.ts",
    "build:entrance-stairs": "tsx scripts/build-entrance-stairs.ts",
    "build:equipment": "tsx scripts/build-equipment.ts",
    "build:transit-holds": "tsx scripts/build-transit-holds.ts",
    "build:e2e": "VITE_E2E=1 VITE_DATA_BACKEND=octo vite build --outDir .e2e-build --emptyOutDir",
    "e2e": "playwright test",
    "build:xray": "tsx scripts/build-xray.ts",
    "build:elevated": "tsx scripts/build-elevated.ts",
    "build:station-shell": "tsx scripts/build-station-shell.ts",
    "build:corners": "tsx scripts/build-corners.ts",
    "build:xray-overrides": "tsx scripts/xray-overrides.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@radix-ui/react-accordion": "1.2.1",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-collapsible": "1.1.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/rapier": "2.2.0",
    "@tanstack/react-query": "5.59.0",
    "@types/geojson": "7946.0.14",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "ai": "7.0.143",
    "autoprefixer": "10.4.20",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "downshift": "9.4.0",
    "ecctrl": "2.0.2",
    "fflate": "0.8.2",
    "gtfs-realtime-bindings": "1.1.1",
    "hono": "4.13.13",
    "leva": "0.10.1",
    "lucide-react": "0.454.0",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "6.15.0",
    "openapi-fetch": "0.15.0",
    "pmtiles": "4.3.0",
    "postcss": "8.5.31",
    "proj4": "2.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-map-gl": "8.1.3",
    "react-router-dom": "6.30.6",
    "sonner": "1.7.0",
    "suncalc": "1.9.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.14",
    "tailwindcss-animate": "1.0.7",
    "tesseract.js": "7.0.0",
    "three": "0.186.1",
    "typescript": "5.6.3",
    "xstate": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@duckdb/node-api": "1.5.6-r.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@size-limit/file": "11.2.0",
    "@types/node": "22.10.2",
    "@types/suncalc": "1.9.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "knip": "5.66.0",
    "manifold-3d": "3.5.4",
    "mapshaper": "0.7.89",
    "openapi-typescript": "7.10.1",
    "size-limit": "11.2.0",
    "three-mesh-bvh": "0.8.3",
    "tsx": "4.19.2",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.19.0"
}
